# The Waveshare ESP32-P4 boards' ESP32-C6-MINI-1U (4 MB flash), as esp_hosted's
# Wi-Fi + BLE co-existence example configures it
# (examples/bluetooth/esp_hosted_nimble/bleprph_wifi_coex/cp). The SDIO pins
# are the C6's fixed slave pins and the datapath mode is negotiated with the
# host, so nothing here names the board's wiring.

# Byte-identical output from the same sources: the pinned
# ESPOS_COPROC_FW_SHA256 (coproc_image.h) is checked against a fresh build in CI.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# Role: co-processor for an MCU host.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# Wi-Fi + BLE: BLE as HCI over the hosted transport, which is what the BLE
# gateway's Bluedroid host on the P4 talks to.
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y

# Two app slots, so an interrupted update leaves the running image in place.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_CACHE_MALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
