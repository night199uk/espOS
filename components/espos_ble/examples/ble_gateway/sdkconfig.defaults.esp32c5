#
# ESP32-C5: BLE scanning, the station and the SignalK client share one chip
# with ~170 KB of internal RAM, which the gateway overran by ~40 KB with
# everything allocated internally (docs/hardware.md). Every C5 module espOS
# has seen carries 8 MB of PSRAM; this file moves into it what does not have
# to be internal, and leaves internal RAM to what does: the BLE controller
# (~24 KB contiguous), WiFi/lwIP and DMA buffers.
#
# CONFIG_SPIRAM is not a bootloader option on the C5 (esp_psram_init() runs
# from cpu_start.c), so this ships by OTA like any other build.
CONFIG_SPIRAM=y

# The Bluedroid host heap, the larger half of the 58 KB "BLE" line. Only the
# controller needs internal memory; the host's osi_malloc() honours this.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# With PSRAM on, malloc() still keeps every request below 16 KB internal --
# nearly all of cJSON, httpd and the SignalK client. Small requests go to
# PSRAM instead; anything that needs DMA or internal RAM asks with caps, and
# the reserve below keeps a pool for exactly those requests.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# TLS record buffers from PSRAM. espos_sk's handshake pre-flight measures the
# pool mbedTLS allocates from, so it follows this setting.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# NOT CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP: with it the station never
# associates on this part (reason 36 every ~21 s, docs/hardware.md).
